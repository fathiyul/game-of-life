# Copy this file to secrets/gcp.env and fill in real values, OR just run:
#   ./scripts/fetch-gcp-env.sh
#
# secrets/gcp.env is gitignored — never commit real values.
# Note: these are deployment coordinates, not access credentials.

GCP_PROJECT_ID="your-project-id"
GCP_REGION="us-central1"
GCP_ZONE="us-central1-a"
GCP_INSTANCE="game-of-life"
GCP_STATUS="RUNNING"
GCP_MACHINE_TYPE="e2-small"
GCP_INTERNAL_IP="10.0.0.0"
GCP_EXTERNAL_IP="35.0.0.0"
GCP_APP_URL="http://35.0.0.0:3000"
GCP_SERVICE_ACCOUNT="NNN-compute@developer.gserviceaccount.com"
